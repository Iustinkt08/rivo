// =============================================================================
// RIVO - Prisma Schema
// DB: PostgreSQL | ORM: Prisma
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  CLIENT
  ADMIN_SALON
  STAFF_MEMBER
  SUPER_ADMIN
}

enum AppointmentStatus {
  PENDING       // Awaiting confirmation
  CONFIRMED     // Confirmed by salon
  CANCELLED     // Cancelled by client or salon
  COMPLETED     // Service delivered
  NO_SHOW       // Client did not appear
}

enum PaymentStatus {
  NOT_REQUIRED  // Pay at salon
  PENDING       // Awaiting payment
  PAID          // Paid in advance via Stripe
  REFUNDED      // Refunded after cancellation
}

enum BookingSource {
  ONLINE        // Booked via client app
  WALK_IN       // Manually added by salon staff
  PHONE         // Added by salon from phone call
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SlotLockStatus {
  ACTIVE
  EXPIRED
  CONVERTED // Converted to a real appointment
}

// =============================================================================
// USER
// =============================================================================

model User {
  id            String    @id @default(uuid())
  firebaseUid   String?   @unique // Firebase / Supabase Auth UID
  email         String?   @unique
  phone         String?   @unique
  firstName     String
  lastName      String
  avatarUrl     String?
  dateOfBirth   DateTime?
  gender        String?
  role          UserRole  @default(CLIENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  clientAppointments  Appointment[]   @relation("ClientAppointments")
  clientReviews       Review[]        @relation("ClientReviews")
  staffProfile        Staff?
  salonAdminOf        Salon[]         @relation("SalonAdmin")
  notifications       Notification[]
  pushTokens          PushToken[]
  addresses           UserAddress[]

  @@map("users")
}

model UserAddress {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  addressLine1 String
  addressLine2 String?
  city         String
  county       String?
  country      String   @default("RO")
  postalCode   String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("user_addresses")
}

// =============================================================================
// SALON
// =============================================================================

model Salon {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique // URL-friendly identifier
  description      String?
  phone            String?
  email            String?
  websiteUrl       String?
  logoUrl          String?
  coverImageUrl    String?
  isActive         Boolean   @default(true)
  isVerified       Boolean   @default(false)

  // Location
  addressLine1     String
  addressLine2     String?
  city             String
  county           String?
  country          String    @default("RO")
  postalCode       String?
  latitude         Float
  longitude        Float

  // Stripe Connect
  stripeAccountId  String?   @unique // Stripe Connect account for payouts

  // Booking settings
  requiresDeposit      Boolean @default(false)
  depositPercentage    Int?    // e.g. 30 = 30%
  cancellationHours    Int     @default(24) // Hours before appointment to allow free cancellation
  slotLockDurationMin  Int     @default(5)  // Minutes to lock a slot during checkout

  // Rating cache (updated via trigger/job)
  averageRating    Float     @default(0)
  reviewCount      Int       @default(0)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  adminId          String
  admin            User            @relation("SalonAdmin", fields: [adminId], references: [id])
  staff            Staff[]
  services         Service[]
  appointments     Appointment[]
  reviews          Review[]
  openingHours     OpeningHours[]
  gallery          SalonPhoto[]
  categories       SalonCategory[]
  slotLocks        SlotLock[]

  @@index([latitude, longitude])
  @@index([city])
  @@map("salons")
}

// =============================================================================
// OPENING HOURS
// =============================================================================

model OpeningHours {
  id        String     @id @default(uuid())
  salonId   String
  salon     Salon      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  openTime  String     // "09:00" - stored as HH:MM string
  closeTime String     // "19:00"
  isClosed  Boolean    @default(false)

  @@unique([salonId, dayOfWeek])
  @@map("opening_hours")
}

// =============================================================================
// SALON GALLERY
// =============================================================================

model SalonPhoto {
  id        String   @id @default(uuid())
  salonId   String
  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("salon_photos")
}

// =============================================================================
// SERVICE CATEGORY (Global taxonomy, e.g. "Hair", "Nails", "Massage")
// =============================================================================

model Category {
  id        String          @id @default(uuid())
  name      String          @unique
  iconUrl   String?
  sortOrder Int             @default(0)

  services        Service[]
  salonCategories SalonCategory[]

  @@map("categories")
}

model SalonCategory {
  salonId    String
  categoryId String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([salonId, categoryId])
  @@map("salon_categories")
}

// =============================================================================
// SERVICE
// =============================================================================

model Service {
  id            String   @id @default(uuid())
  salonId       String
  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  name          String
  description   String?
  durationMin   Int      // Duration in minutes, e.g. 45
  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("RON")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  staffServices    StaffService[]
  appointments     Appointment[]

  @@index([salonId])
  @@map("services")
}

// =============================================================================
// STAFF
// =============================================================================

model Staff {
  id          String   @id @default(uuid())
  salonId     String
  salon       Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  userId      String?  @unique // Optional: staff can have a login
  user        User?    @relation(fields: [userId], references: [id])
  firstName   String
  lastName    String
  specialty   String?  // client-facing role label, e.g. "Hairstylist"
  avatarEmoji String?  // emoji avatar fallback when no photo is set
  avatarUrl   String?
  bio         String?
  phone       String?
  // Backend-issued staff login (salon-scoped account). passwordHash must NEVER
  // be exposed through any API response.
  username    String?  @unique
  passwordHash String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  staffServices   StaffService[]
  workSchedules   StaffSchedule[]
  appointments    Appointment[]
  timeOffBlocks   TimeOffBlock[]

  @@index([salonId])
  @@map("staff")
}

// =============================================================================
// STAFF <-> SERVICE (junction: which staff performs which services)
// =============================================================================

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@map("staff_services")
}

// =============================================================================
// STAFF WEEKLY SCHEDULE (individual working hours per day)
// =============================================================================

model StaffSchedule {
  id        String    @id @default(uuid())
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String    // "09:00"
  endTime   String    // "17:00"
  isOff     Boolean   @default(false)

  @@unique([staffId, dayOfWeek])
  @@map("staff_schedules")
}

// =============================================================================
// TIME-OFF / BREAK BLOCKS (specific date ranges when staff is unavailable)
// =============================================================================

model TimeOffBlock {
  id        String   @id @default(uuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?  // e.g. "Lunch", "Vacation"

  @@index([staffId, startAt])
  @@map("time_off_blocks")
}

// =============================================================================
// APPOINTMENT (core booking entity)
// =============================================================================

model Appointment {
  id             String            @id @default(uuid())

  // Participants
  clientId       String
  client         User              @relation("ClientAppointments", fields: [clientId], references: [id])
  salonId        String
  salon          Salon             @relation(fields: [salonId], references: [id])
  staffId        String
  staff          Staff             @relation(fields: [staffId], references: [id])
  serviceId      String
  service        Service           @relation(fields: [serviceId], references: [id])

  // Timing
  startAt        DateTime
  endAt          DateTime

  // Status & Source
  status         AppointmentStatus @default(PENDING)
  source         BookingSource     @default(ONLINE)
  paymentStatus  PaymentStatus     @default(NOT_REQUIRED)

  // For walk-in / phone appointments - client may not have an account
  guestName      String?
  guestPhone     String?

  // Pricing snapshot (captured at booking time, in case prices change later)
  priceSnapshot  Decimal           @db.Decimal(10, 2)
  currency       String            @default("RON")

  // Stripe
  stripePaymentIntentId String?

  // Notes
  clientNotes    String?   // From client to salon
  internalNotes  String?   // Salon-internal, not visible to client

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cancelledAt    DateTime?
  cancelledBy    String?   // userId who cancelled

  // Relations
  review         Review?
  payment        Payment?

  @@index([salonId, startAt])
  @@index([staffId, startAt])
  @@index([clientId])
  @@map("appointments")
}

// =============================================================================
// SLOT LOCK (prevents double-booking during 5-minute checkout window)
// =============================================================================

model SlotLock {
  id          String         @id @default(uuid())
  salonId     String
  salon       Salon          @relation(fields: [salonId], references: [id])
  staffId     String
  serviceId   String
  startAt     DateTime
  endAt       DateTime
  sessionId   String         // Anonymous session or userId locking the slot
  status      SlotLockStatus @default(ACTIVE)
  expiresAt   DateTime       // now() + slotLockDurationMin
  createdAt   DateTime       @default(now())

  @@index([staffId, startAt, status])
  @@index([expiresAt]) // For cleanup job
  @@map("slot_locks")
}

// =============================================================================
// REVIEW
// =============================================================================

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  clientId      String
  client        User        @relation("ClientReviews", fields: [clientId], references: [id])
  salonId       String
  salon         Salon       @relation(fields: [salonId], references: [id])
  rating        Int         // 1-5
  comment       String?
  replyText     String?     // Salon's public reply
  repliedAt     DateTime?
  isVisible     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([salonId])
  @@map("reviews")
}

// =============================================================================
// PAYMENT (Stripe transaction log)
// =============================================================================

model Payment {
  id                    String      @id @default(uuid())
  appointmentId         String      @unique
  appointment           Appointment @relation(fields: [appointmentId], references: [id])
  stripePaymentIntentId String      @unique
  amount                Decimal     @db.Decimal(10, 2)
  currency              String      @default("RON")
  platformFee           Decimal     @db.Decimal(10, 2) // Rivo's commission
  status                PaymentStatus
  paidAt                DateTime?
  refundedAt            DateTime?
  refundAmount          Decimal?    @db.Decimal(10, 2)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("payments")
}

// =============================================================================
// CLIENT PROFILE / MINI-CRM (per salon view of a client)
// =============================================================================

model ClientSalonProfile {
  id               String   @id @default(uuid())
  salonId          String
  clientId         String   // References User.id
  totalVisits      Int      @default(0)
  noShowCount      Int      @default(0)
  internalNotes    String?  // Visible only to salon
  isBlocked        Boolean  @default(false) // Salon can block a client
  lastVisitAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([salonId, clientId])
  @@map("client_salon_profiles")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  data        Json?    // Additional payload (e.g. appointmentId)
  isRead      Boolean  @default(false)
  sentAt      DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // Expo Push Token or FCM token
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())

  @@map("push_tokens")
}
